{
  "opencollection": "1.0.0",
  "info": {
    "name": "Western Union Mass Payments Balances Orders API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.westernunion.com/customers/:clientId/orders",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "The partner's Western Union client ID."
              }
            ]
          },
          "docs": "Returns all payment orders for the customer account."
        },
        {
          "info": {
            "name": "Get Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.westernunion.com/customers/:clientId/orders/:orderId",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "The partner's Western Union client ID."
              },
              {
                "name": "orderId",
                "value": "",
                "type": "path",
                "description": "The order identifier."
              }
            ]
          },
          "docs": "Returns the details and status of a specific payment order."
        }
      ]
    }
  ],
  "bundled": true
}